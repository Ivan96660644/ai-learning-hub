# NeoLearn AI Assistant — server-side configuration (copy to .env.local).
# Never commit real values. None of these use the NEXT_PUBLIC_ prefix,
# so they are only readable on the server and never shipped to the browser.

# Provider: none | openai-compatible | mify
# Default "none" → the assistant shows an "unavailable" notice and makes no calls.
AI_PROVIDER=none

# --- openai-compatible (any /chat/completions-compatible endpoint you are licensed to use)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Mify (disabled: public-use authorization not yet confirmed)
# Keep MIFY_AUTHORIZED=false until written authorization is obtained.
# Even when true, the adapter refuses calls until the API contract is confirmed.
MIFY_AUTHORIZED=false
MIFY_BASE_URL=
MIFY_API_KEY=
MIFY_MODEL=

# --- Guards
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_QUOTA=50
# true = reject unauthenticated requests (auth hook in lib/ai/guard.ts is a TODO)
AI_REQUIRE_AUTH=false
